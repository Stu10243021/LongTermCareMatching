@model IEnumerable<LongTermCareMatching.Models.Case>

@{
    ViewData["Title"] = "我的需求案件";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📋 我發布的照顧需求</h2>
        <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">➕ 發布新需求</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 py-5 text-center">
            <div class="card-body">
                <p class="text-muted fs-5 mb-3">您目前尚未發布過任何照顧需求案件喔！</p>
                <a asp-action="Create" class="btn btn-primary fw-bold">立即發布第一個需求</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>需求標題</th>
                            <th>服務項目</th>
                            <th>服務地點</th>
                            <th>預估預算</th>
                            <th>案件狀態</th>
                            <th>發布日期</th>
                            <th class="text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Title</td>
                                <td><span class="badge bg-info text-dark">@item.ServiceType</span></td>
                                <td>桃園市 @item.Location</td>
                                <td class="text-danger fw-bold">$@item.EstimatedBudget 元</td>
                                <td>
                                    @if (item.Status == "Draft")
                                    {
                                        <span class="badge bg-secondary">⚪ 草稿 (未授權)</span>
                                    }
                                    else if (item.Status == "Open")
                                    {
                                        <span class="badge bg-success">🟢 開放接案中</span>
                                    }
                                    else if (item.Status == "InProgress")
                                    {
                                        <span class="badge bg-warning text-dark">🟡 洽談 / 服務中</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">⚫ 已結束</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="text-center">
                                    @if (item.Status == "Draft")
                                    {
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="ConfirmPayment" asp-route-id="@item.Id" class="btn btn-warning btn-sm fw-bold">💳 繼續授權</a>
                                            <form asp-action="DeleteDraft" asp-route-id="@item.Id" method="post" onsubmit="return confirm('確定要刪除這筆草稿嗎？');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">🗑️ 刪除</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm fw-bold">💬 查看詳情與對話</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>