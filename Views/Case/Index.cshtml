@model IEnumerable<LongTermCareMatching.Models.Case>

@{
    ViewData["Title"] = "接案大廳";
    var announcements = ViewBag.Announcements as List<LongTermCareMatching.Models.Announcement> ?? new List<LongTermCareMatching.Models.Announcement>();
}

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            ❌ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (announcements.Any())
    {
        <div class="card border-0 bg-white shadow-sm mb-4 border-start border-4 border-primary">
            <div class="card-body">
                <h5 class="fw-bold text-primary mb-3">📢 平台最新公告</h5>
                <div class="list-group list-group-flush">
                    @foreach (var ann in announcements)
                    {
                        <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center ps-0 pe-0 border-bottom-0 py-1">
                            <div>
                                @if (ann.IsPinned)
                                {
                                    <span class="badge bg-danger me-1">📌 置頂</span>
                                }
                                <span class="badge bg-info text-dark me-2">@ann.Category</span>
                                <strong class="text-dark">@ann.Title</strong>
                                <span class="text-muted ms-2 d-none d-md-inline">— @ann.Content</span>
                            </div>
                            <small class="text-muted">@ann.CreatedAt.ToString("yyyy/MM/dd")</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📢 長照需求大廳</h2>
        <a asp-action="Create" class="btn btn-outline-success fw-bold">+ 我要發布需求</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4">
            <h4>目前還沒有開放中的照顧需求喔！</h4>
            <p class="text-muted mb-0">歡迎家屬點擊右上角「我要發布需求」新增案件。</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title text-primary fw-bold">@item.Title</h5>
                                <span class="badge bg-danger fs-6">$@item.EstimatedBudget 元</span>
                            </div>
                            <p class="card-text text-muted mb-2 mt-2">
                                📍 <strong>地點：</strong>桃園市 @item.Location<br />
                                ⏰ <strong>時數：</strong>@item.ServiceTime 小時<br />
                                🏥 <strong>類別：</strong>@item.ServiceType @(item.ServiceType == "陪診" ? $"({item.Hospital})" : "")
                            </p>
                            <p class="card-text">
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    @(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                }
                                else
                                {
                                    <span class="text-muted">（無詳細描述）</span>
                                }
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 text-end pb-3">
                            <small class="text-muted float-start mt-1">發布時間：@item.CreatedAt.ToString("yyyy/MM/dd")</small>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary px-3 fw-bold">查看詳情 / 應徵</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>